<?xml version="1.0" encoding="UTF-8"?>
<!-- PMD rules for Project Pulse: PMD's quickstart set, minus the rules the team has decided not to
     enforce. To drop a rule, add an exclude inside the quickstart reference, with a comment giving
     the reason, for example:

       <exclude name="ControlStatementBraces"/>

     To add a rule from outside quickstart, add its own <rule ref="category/java/..."/> line.
     Every change here is a reviewed decision. -->
<ruleset name="Project Pulse"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD quickstart, with Project Pulse's decisions.</description>
    <rule ref="rulesets/java/quickstart.xml">
        <!-- D2: UnnecessaryConstructor and UncommentedEmptyConstructor are enforced. A JPA entity's
             no-argument constructor is required at runtime, and deleting one compiles but fails when
             Hibernate loads the entity; each required one now carries a comment saying so. -->
        <!-- D3: ControlStatementBraces is enforced. An unbraced if body that later gains a second
             line runs that line unconditionally, the goto-fail bug; braces cost one line each. -->
        <!-- D4: GuardLogStatement is off. Project Pulse logs through SLF4J {} placeholders, so no
             message string is built when a level is disabled, and every argument passed is a plain
             getter or count; a guard would add lines and save nothing. -->
        <exclude name="GuardLogStatement"/>
    </rule>
</ruleset>
